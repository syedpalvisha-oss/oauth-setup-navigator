# Copy to .env at the repo root for local development. On Render, set these in the dashboard instead (see DEPLOY.md).

# Required to generate new guides (the committed guide library works without them)
TAVILY_API_KEY=
GROQ_API_KEY=

# Optional: Gemini is only a fallback for the final "Writing guide" stage. Leave blank to not use it at all.
GEMINI_API_KEY=

# Optional: Upstash Redis keeps generated guides across restarts. Leave blank to use the in-memory cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
PORT=3001
# Number of reverse-proxy hops in front of the server, for the per-IP rate limit (defaults: 1 in production, 0 locally)
# TRUST_PROXY=1
# Set to 1 to skip the Chromium download and browser-rendered probes (plain fetches only)
# PLAYWRIGHT_DISABLED=1
